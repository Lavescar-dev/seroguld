# Copy this file as .seroguld-sync.env and adjust only the values you need.

# Remote SSH target (Laptop 192.168.1.105 defaults to this value)
SEROGULD_SYNC_REMOTE_HOST="192.168.1.105"
SEROGULD_SYNC_REMOTE_USER="lavescar-hp"
SEROGULD_SYNC_REMOTE_PORT="22"

# Remote repository (working tree)
SEROGULD_SYNC_REMOTE_DIR="/home/lavescar-hp/Clients/Recai_Demir/seroguld-crm"

# Local branch that should stay in parity
SEROGULD_SYNC_BRANCH="build/seroguld-feedback-20260610-140000"

# Rsync excludes to reduce transfer size (kept in sync scripts too)
SEROGULD_SYNC_RSYNC_EXCLUDES=(
  ".venv/"
  "backend/.venv/"
  "frontend/node_modules/"
  "frontend/.vite/"
  "desktop/node_modules/"
  "desktop/dist/"
  "desktop/src-tauri/target/"
  "target/"
  "tools/rclone/rclone"
  "data/backups/"
  "data/restore-drill/"
  "data/offsite-mirror/"
  "data/logs/"
  "data/uploads/"
  "data/documents/"
  ".run/"
  "artifacts/"
)

# Sensitive files bundle list for secret transfer
SEROGULD_SYNC_SECRET_FILES=(
  ".env"
  ".env.local"
  ".env.*.local"
  "docs/*vps*"
  "docs/*secret*"
  "docs/*credential*"
  "ops/*"
)

# Optional local-only passphrase for gpg operations (empty = interactive prompt)
SEROGULD_SYNC_SECRETS_PASSPHRASE=""

# Bundle name used for secret transfer
SEROGULD_SYNC_SECRET_BUNDLE="seroguld-secrets.tar.gz"
