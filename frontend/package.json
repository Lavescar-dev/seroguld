    "@tauri-apps/api": "^2.8.0",
    "clsx": "^2.1.1",
    "i18next": "^25.4.1",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.12",
