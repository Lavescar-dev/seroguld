{
  "name": "seroguld-crm-frontend",
  "version": "0.3.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3300",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3300",
